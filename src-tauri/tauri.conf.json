{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "cashier",
    "version": "1.0.0"
  },  "plugins": {
    "sql": {
      "preload": ["sqlite:cashier.db"]
    }
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "windows": [
      {
        "title": "cashier",
         "maximized": true,
        "decorations":true,
        "visible":false,
        "label": "main"
      },
      {
        "width": 1000,
   "height": 1000,
   "decorations": false,
   "url": "splashscreen.html",
   "label": "splashscreen",
   "transparent": true,
   "center": true,
   "visible":true
      },
      {
        "width": 800,
   "height": 800,
   "decorations": false,
   "url": "login.html",
   "label": "login",
   "transparent": true,
   "center": true,
   "visible":false

      },
      {
        "width": 1200,
   "height": 1200,
   "decorations": false,
   "url": "singup.html",
   "label": "singup",
   "transparent": true,
   "center": true,
   "visible":false
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.gestcashier.dev",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],"windows": {
        "webviewInstallMode": {
          "silent": true,
          "type": "offlineInstaller"
        }
      }
    }
  }
}
